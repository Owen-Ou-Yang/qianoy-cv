---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkflowOverview from '../../components/WorkflowOverview.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
const nextProject = projects.length > 1 ? projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length] : null;
---
<BaseLayout title={project.title} description={project.summary} noindex={project.isPlaceholder}>
  <article class="study-page">
    <a class="back-link" href="/#selected-work">← Selected research</a>
    <PageHeader eyebrow={project.theme} title={project.title} description={project.summary} />
    <div class="study-meta"><span>{project.status}</span>{project.date && <span>{project.date}</span>}</div>
    {project.workflow && <WorkflowOverview workflow={project.workflow} />}
    {project.figure && <figure class="research-figure study-figure"><img src={project.figure.src} alt={project.figure.alt} width={project.figure.width} height={project.figure.height} decoding="async" fetchpriority="high" /><figcaption>{project.figure.caption}</figcaption><div class="figure-links"><a href={project.figure.download ?? project.figure.src}>Open full-size figure <span aria-hidden="true">↗</span></a>{project.dataFile && <a href={project.dataFile} download>Download figure data (CSV) <span aria-hidden="true">↓</span></a>}</div></figure>}
    <div class="study-body">
      <aside class="study-context"><h2>Context</h2>{project.role && <p>{project.role}</p>}{project.repository && <p><a href={project.repository}>Related workflow code <span aria-hidden="true">↗</span></a></p>}<p><a href="/cv/">Curriculum vitae</a></p></aside>
      <div class="study-prose">
        <section class="detail-section"><h2>Research question</h2><p>{project.question}</p></section>
        <section class="detail-section"><h2>Approach</h2><ul>{project.methodology.map(method => <li>{method}</li>)}</ul></section>
        <section class="detail-section"><h2>{project.resultsHeading ?? 'What the measurements show'}</h2><ul>{project.results.map(result => <li>{result}</li>)}</ul>{project.resultsNote && <p class="space-top">{project.resultsNote}</p>}</section>
        {!!project.limitations?.length && <section class="detail-section"><h2>Scope & limitations</h2><ul>{project.limitations.map(limit => <li>{limit}</li>)}</ul></section>}
        {!!project.references?.length && <section class="detail-section"><h2>Data attribution</h2>{project.references.map(reference => <p><a href={reference.url}>{reference.label} <span aria-hidden="true">↗</span></a>{reference.note && <span class="reference-note">{reference.note}</span>}</p>)}</section>}
      </div>
    </div>
    {nextProject && <section class="section next-study" aria-labelledby="next-study-heading"><div><p class="eyebrow">Continue exploring</p><h2 id="next-study-heading">{nextProject.title}</h2></div><a class="text-link" href={`/projects/${nextProject.slug}/`}>Read the case study <span aria-hidden="true">↗</span></a></section>}
  </article>
</BaseLayout>
