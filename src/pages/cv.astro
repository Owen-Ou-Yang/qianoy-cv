---
import BaseLayout from '../layouts/BaseLayout.astro';
import { displayName, profile } from '../data/site';
import { cv, cvEducation, cvResearch, cvCourseProjects } from '../data/cv';
---
<BaseLayout title="CV" description="Qian Ouyang's education, Notre Dame research experience, computer vision course project, and selected skills.">
  <div class="cv-document">
    <header class="cv-heading">
      <div class="cv-title-row"><h1>{displayName}</h1><a href="/cv.pdf" download>Download PDF <span aria-hidden="true">↓</span></a></div>
      <ul class="profile-links" aria-label="Contact and profile links">
        {profile.email && <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>}
        <li><a href={profile.siteUrl}>{profile.domain}</a></li>
        {profile.github && <li><a href={profile.github}>GitHub</a></li>}
      </ul>
    </header>
    <section id="education" class="cv-section" aria-labelledby="cv-education-heading">
      <h2 id="cv-education-heading">Education</h2>
      {cvEducation.map(entry => <article id={entry.id} class="cv-entry">
        <div class="cv-entry-heading"><h3>{entry.institution}</h3><p class="cv-date">{entry.dates}</p></div>
        <p>{entry.description}</p>
        {entry.program && <p>{entry.program}</p>}
        {entry.semesterGpa && <p><strong>Semester GPA: {entry.semesterGpa}</strong> · {entry.credits} credits</p>}
        {entry.courses.length > 0 && <p class="cv-coursework"><strong>Selected coursework:</strong> {entry.courses.map((course, index) => <>{index > 0 && '; '}{course.name}{course.level === 'Graduate level' && ' — graduate level'} ({course.grade})</>)}.</p>}
      </article>)}
    </section>
    <section id="research-experience" class="cv-section" aria-labelledby="cv-research-heading">
      <h2 id="cv-research-heading">Research Experience</h2>
      {cvResearch.map((entry, index) => <article id={entry.id} class="cv-entry">
        {(index === 0 || cvResearch[index - 1].institution !== entry.institution) && <h3 class="cv-institution">{entry.institution}</h3>}
        <div class="cv-entry-heading"><p class="cv-role">{entry.role}</p><p class="cv-date">{entry.dates}</p></div>
        {entry.group && <p class="cv-affiliation">{entry.group}</p>}
        {entry.topics.map(topic => <section id={topic.id} class="cv-topic" aria-labelledby={`${topic.id}-heading`}><h4 id={`${topic.id}-heading`}>{topic.title}</h4>{topic.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
      </article>)}
    </section>
    <section id="course-project" class="cv-section" aria-labelledby="cv-course-heading">
      <h2 id="cv-course-heading">Course Project</h2>
      {cvCourseProjects.map(entry => <article id={entry.id} class="cv-entry">
        <div class="cv-entry-heading"><h3>{entry.title}</h3><p class="cv-date">{entry.term}</p></div>
        <p class="cv-affiliation">{entry.course}, {entry.institution} · Instructor: {entry.instructor}</p>
        <p>{entry.paragraph}</p>
      </article>)}
    </section>
    <section id="skills" class="cv-section" aria-labelledby="cv-skills-heading">
      <h2 id="cv-skills-heading">Skills</h2>
      <dl class="cv-skills">{cv.skills.map(skill => <div><dt>{skill.label}</dt><dd>{skill.items.join(', ')}</dd></div>)}</dl>
    </section>
  </div>
</BaseLayout>
