---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchLine from '../components/ResearchLine.astro';
import Education from '../components/Education.astro';
import { displayName, profile, formatReviewDate } from '../data/site';
import { researchLines } from '../data/research-lines';
---
<BaseLayout title="Home" description={profile.metaDescription}>
  <section class="hero" aria-labelledby="intro-heading">
    <h1 id="intro-heading">{displayName}</h1>
    <div class="affiliations">{profile.overview.affiliations.map(line => <p>{line}</p>)}</div>
    <p class="hero-copy">{profile.overview.summary}</p>
    {profile.researchReviewedOn && <p class="review-date">Research status reviewed <time datetime={profile.researchReviewedOn}>{formatReviewDate(profile.researchReviewedOn)}</time></p>}
    <div class="actions profile-actions">
      <a class="button" href="/cv.pdf">{profile.cvIsDraft ? 'CV (PDF · draft)' : 'CV (PDF)'} <span aria-hidden="true">↓</span></a>
      {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
      {profile.github && <a href={profile.github}>GitHub</a>}
      {profile.linkedin && <a href={profile.linkedin}>LinkedIn</a>}
    </div>
  </section>
  <section class="section section-grid" aria-labelledby="academic-background-heading"><div><h2 id="academic-background-heading">Academic background</h2></div><Education compact /></section>
  {researchLines.length > 0 && <section id="selected-work" class="selected-work" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">Research lines</h2><a href="/research/">Research details <span aria-hidden="true">→</span></a></div>
    {researchLines.map(line => <ResearchLine line={line} compact heading="h3" />)}
  </section>}
  <p class="home-more">More about my <a href="/about/">background</a> and <a href="/cv/">academic experience</a>.</p>
</BaseLayout>
