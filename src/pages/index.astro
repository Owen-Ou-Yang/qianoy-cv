---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { displayName, profile } from '../data/site';
import { projects } from '../data/projects';
const selectedProjects = projects.filter(project => project.selected);
---
<BaseLayout title="Home" description={profile.metaDescription}>
  <section class="hero" aria-labelledby="intro-heading">
    <h1 id="intro-heading">{displayName}</h1>
    <div class="affiliations">{profile.overview.affiliations.map(line => <p>{line}</p>)}</div>
    <p class="hero-copy">{profile.overview.summary}</p>
    <div class="actions profile-actions">
      <a class="button" href="/cv.pdf">{profile.cvIsDraft ? 'CV (PDF · draft)' : 'CV (PDF)'} <span aria-hidden="true">↓</span></a>
      {profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
      {profile.github && <a href={profile.github}>GitHub</a>}
      {profile.linkedin && <a href={profile.linkedin}>LinkedIn</a>}
    </div>
  </section>
  {selectedProjects.length > 0 && <section id="selected-work" class="selected-work" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">Selected research</h2><a href="/research/#research-interests">Research interests <span aria-hidden="true">→</span></a></div>
    {selectedProjects.map((project, index) => <ProjectEntry project={project} index={index} />)}
  </section>}
  <p class="home-more">More about my <a href="/about/">background</a> and <a href="/cv/">academic experience</a>.</p>
</BaseLayout>
