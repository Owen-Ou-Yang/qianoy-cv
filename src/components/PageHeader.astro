---
interface Props { eyebrow?: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
const showEyebrow = eyebrow && eyebrow.trim().toLowerCase() !== title.trim().toLowerCase();
---
<header class="page-heading">
  {showEyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {description && <p class="page-intro">{description}</p>}
</header>
