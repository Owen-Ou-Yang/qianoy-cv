---
import { profile } from '../data/site';
import Todo from './Todo.astro';
---
<div>
  <dl class="skills-list"><div><dt>Programming</dt><dd>{profile.programmingLanguages.length ? profile.programmingLanguages.join(', ') : <Todo text="TODO: Confirm programming languages to list" />}</dd></div>{profile.skills.map(skill => <div><dt>{skill.title}</dt><dd>{skill.description}</dd></div>)}</dl>
</div>
