---
import type { Project } from '../data/projects';
interface Props { project: Project; index: number; heading?: 'h2' | 'h3'; }
const { project, index, heading: Heading = 'h3' } = Astro.props;
---
<article class="project-entry">
  <span class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div>
    <p class="eyebrow">{project.theme}</p>
    <Heading class="project-title"><a href={`/projects/${project.slug}/`}>{project.title}<span class="entry-arrow" aria-hidden="true">↗</span></a></Heading>
    <p>{project.summary}</p>
    <p class="entry-status">{project.isPlaceholder ? 'Draft entry · project details to add' : (project.status ?? 'TODO: Project status')}</p>
  </div>
</article>
