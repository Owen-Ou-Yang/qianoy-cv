---
import ProjectEntry from './ProjectEntry.astro';
import type { ResearchLine } from '../data/research-lines';
interface Props { line: ResearchLine; compact?: boolean; heading?: 'h2' | 'h3'; }
const { line, compact = false, heading: Heading = 'h2' } = Astro.props;
const projectHeading = Heading === 'h2' ? 'h3' : 'h4';
const featuredStages = line.stages.filter(stage => stage.featured);
const additionalStages = line.stages.filter(stage => !stage.featured);
---
<section id={line.id} class:list={['research-line', { 'research-line-compact': compact }]} aria-labelledby={`${line.id}-title`}>
  <Heading id={`${line.id}-title`} class="research-line-title">{compact ? <a href={`/research/#${line.id}`}>{line.title}</a> : line.title}</Heading>
  <p class="line-summary">{line.summary}</p>
  {compact ? <ul class="line-selected-work" aria-label={`Selected work in ${line.title}`}>
    {featuredStages.map(({ project, preview }) => <li><a href={`/projects/${project.slug}/`}>{preview?.title ?? project.preview?.title ?? project.title}</a></li>)}
  </ul> : <>
    <p class="line-question"><strong>Shared question.</strong> {line.question}</p>
    <div class="line-studies">{featuredStages.map(({ project, label, preview }, index) => <ProjectEntry project={project} index={index} heading={projectHeading} stageLabel={label} preview={preview} />)}</div>
    {additionalStages.length > 0 && <details class="additional-work"><summary>Additional explorations ({additionalStages.length})</summary><div class="line-studies">{additionalStages.map(({ project, label, preview }, index) => <ProjectEntry project={project} index={index} heading={projectHeading} stageLabel={label} preview={preview} />)}</div></details>}
  </>}
</section>
