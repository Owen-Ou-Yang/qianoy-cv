---
import { navigation, profile, siteTitle } from '../data/site';
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean; canonicalPath?: string; }
const { title, description = profile.identity, noindex = false, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, profile.siteUrl).href;
const fullTitle = title === 'Home' ? `${siteTitle} | AI for Materials & Molecular Simulation` : `${title} | ${siteTitle}`;
const person = profile.name ? { '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: profile.siteUrl, description: profile.identity, sameAs: [profile.github, profile.linkedin].filter(Boolean) } : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#182d45" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={profile.socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {profile.socialImage && <><meta property="og:image" content={new URL(profile.socialImage, profile.siteUrl).href} /><meta name="twitter:image" content={new URL(profile.socialImage, profile.siteUrl).href} /><meta property="og:image:alt" content={`${siteTitle} — ${profile.identity}`} /></>}
    {person && <script is:inline type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label={`${siteTitle} home`}><span class="wordmark-symbol" aria-hidden="true">q.</span><span>{profile.domain}</span></a>
      <nav aria-label="Main navigation"><ul>{navigation.map(item => <li><a href={item.href} aria-current={(item.href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>
    </header>
    <main id="main" class="wrap" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-name" href="/">{siteTitle}</a><p>AI for materials & molecular simulation</p></div>
      <div class="footer-links"><a href="/cv/">Curriculum vitae</a><a href="/contact/">Contact <span aria-hidden="true">↗</span></a></div>
    </footer>
  </body>
</html>
